# --- Backup ---
# ACCOUNT=backup
ACCOUNT_EMAIL=me@example.com
# ACCOUNT_BASE_URL=https://vault.example.com
BW_PASSWORD=xxxxx
# Personal API key, only needed once (bitwarden.com bot-detection bypass):
# BW_BACKUP_REGISTER_CLIENT_ID=user.xxxxxx
# BW_BACKUP_REGISTER_CLIENT_SECRET=xxxxx
# ENCRYPTION_PASSPHRASE=mySecret1234
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# --- Sync ---
# Source vault
# SRC_ACCOUNT=source
SRC_ACCOUNT_EMAIL=me@example.com
# SRC_ACCOUNT_BASE_URL=https://vault.example.com
SRC_BW_PASSWORD=xxxxx
# SRC_REGISTER_CLIENT_ID=user.xxxxxx
# SRC_REGISTER_CLIENT_SECRET=xxxxx

# Destination vault
# DEST_ACCOUNT=destination
DEST_ACCOUNT_EMAIL=me@vaultwarden.example
DEST_ACCOUNT_BASE_URL=https://vault.example.com
DEST_BW_PASSWORD=xxxxx
# DEST_REGISTER_CLIENT_ID=user.xxxxxx
# DEST_REGISTER_CLIENT_SECRET=xxxxx

# BW_SYNC_MODE=personal
# set DEST_BW_PURGE_VAULT to purge the dest vault (personal mode only) before the import.
# DEST_BW_PURGE_VAULT=1

# For BW_SYNC_MODE=collections instead:
# DEST_BW_ORG=My-Org
# DEST_BW_COLLECTIONS=default,Some Other Collection
